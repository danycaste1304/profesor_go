<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Near Field Communication Tag Reading capability (NDEF + raw TAG sessions).
	     Referenced from the Runner target via CODE_SIGN_ENTITLEMENTS in project.pbxproj.
	     TODO_EXTERNAL: enable the "Near Field Communication Tag Reading" capability on the
	     App ID in the Apple Developer portal before signing a device build. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
	</array>
</dict>
</plist>
